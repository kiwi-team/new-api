# 首次运行 ./init-env.sh：生成 .env 和五个独立的随机密码/密钥。
# 此文件中的空密码不能直接用于启动。
COMPOSE_PROJECT_NAME=new-api
TZ=Asia/Shanghai

# 示例域名；部署前改成已解析到服务器的真实域名，不带协议和路径。
DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# 与 ../build-image.sh 的默认仓库一致；标签改成你已构建并推送的版本。
NEW_API_IMAGE=kimiteam-ap-southeast-3.cr.volces.com/newapi/newapi-full
NEW_API_TAG=2026-10-30_15-04-06
NODE_NAME=new-api-docker

# 如果此网段与已有网络冲突，同时调整子网和其中的两个服务地址。
PROXY_SUBNET=172.30.70.0/24
CADDY_IP=172.30.70.2
NEW_API_IP=172.30.70.3

# 云数据库模式：填写完整 PostgreSQL URL，并使用 -f docker-compose.yml 启动。
# 本地数据库模式：留空，默认加载 docker-compose.override.yml。
# SQL_DSN=postgresql://newapi:URL_ENCODED_PASSWORD@postgres.example.com:5432/newapi?sslmode=verify-full
# 云厂商提供专用 CA 时，将 PEM 文件放入 postgresql/certs/root.crt，并在 URL 追加：
# &sslrootcert=/etc/new-api/postgresql/root.crt
SQL_DSN=

# 可选的独立日志库连接；留空复用 SQL_DSN。可与主库使用不同实例/数据库。
# 独立日志库须预先创建并授权；本地初始化脚本只创建 POSTGRES_DB。
# LOG_SQL_DSN=postgresql://newapi_logs:URL_ENCODED_PASSWORD@log-postgres.example.com:5432/newapi_logs?sslmode=verify-full
# 专用日志库 CA 可放入 postgresql/certs/log-root.crt，并在日志 URL 追加：
# &sslrootcert=/etc/new-api/postgresql/log-root.crt
LOG_SQL_DSN=

# 以下三个账号配置仅用于本地 PostgreSQL；外部数据库不会使用这些密码。
# 密码由初始化脚本生成十六进制字符串，可直接安全用于连接 URL。
POSTGRES_DB=newapi
POSTGRES_APP_USER=newapi
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
CRYPTO_SECRET=
