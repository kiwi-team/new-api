{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Flush streamed AI responses immediately; WebSocket upgrades work automatically.
	reverse_proxy new-api:3000 {
		flush_interval -1
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 10s
			response_header_timeout 1800s
		}
	}
}
