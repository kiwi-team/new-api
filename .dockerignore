# Deny by default so unrelated local files never enter the build context.
**

# Build definitions, module manifests, version, and required notices.
!Dockerfile
!Dockerfile.dev
!.dockerignore
!go.mod
!go.sum
!main.go
!VERSION
!LICENSE
!NOTICE
!THIRD-PARTY-LICENSES.md

# Go source packages, local modules, and their embedded resources.
# Add new top-level source packages here; both Dockerfiles copy this filtered context.
!common/
!common/**
!constant/
!constant/**
!controller/
!controller/**
!dto/
!dto/**
!i18n/
!i18n/**
!logger/
!logger/**
!middleware/
!middleware/**
!model/
!model/**
!oauth/
!oauth/**
!pkg/
!pkg/**
!plugins/
!plugins/**
!relay/
!relay/**
!relaykit/
!relaykit/**
!router/
!router/**
!search/
!search/**
!service/
!service/**
!setting/
!setting/**
!tokenkit/
!tokenkit/**
!types/
!types/**

# Only the inputs used by the web production build.
!web/
web/*
!web/package.json
!web/bun.lock
!web/index.html
!web/rsbuild.config.ts
!web/tsconfig.json
!web/tsconfig.app.json
!web/tsconfig.node.json
!web/src/
!web/src/**
!web/public/
!web/public/**

# Explicit exclusions for local profiling output, Python tools, and logs.
/pprof/
/py/
/logs/

# Local metadata and development-only files within allowed source directories.
**/.git
**/.DS_Store
**/.env*
**/node_modules
**/*_test.go
**/testdata
**/*.bak
**/*.md
!THIRD-PARTY-LICENSES.md
